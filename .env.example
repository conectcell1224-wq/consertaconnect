# =========================================================
#  ConsertaConnect — variáveis de ambiente (exemplo)
#  Copie para .env e preencha com os dados do SEU projeto.
# =========================================================

# URL do projeto Supabase (Settings → API → Project URL)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública anon (Settings → API → Project API keys → anon public)
# É segura no front-end: a proteção real vem do RLS.
SUPABASE_ANON_KEY=sua-chave-anon-aqui

# NUNCA exponha esta no navegador — use apenas em scripts locais/servidor
# SUPABASE_SERVICE_ROLE_KEY=
